# Copy this file to .env and change the passwords.
# .env is git-ignored; .env.example is committed as documentation.

# --- Host ports (change if something else already uses them) ---
API_PORT=8080
POSTGRES_PORT=5432
MONGO_PORT=27017

# --- PostgreSQL ---
POSTGRES_USER=mscs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mscs
# Password of the restricted role "mscs_app" that the API logs in as (subject to RLS).
APP_DB_PASSWORD=change-me

# --- MongoDB ---
MONGO_USER=mscs
MONGO_PASSWORD=change-me
MONGO_DB=mscs

# --- Background worker ---
# Go durations: 30s, 15m, 24h. Unpaid storefront orders are cancelled after ORDER_PAYMENT_WINDOW.
ORDER_PAYMENT_WINDOW=24h
WORKER_INTERVAL=1m
